extends "res://tests/support/input_scene_probe.gd"
## Controlled positioning/stock, real keyboard and mouse; normal world simulation.
const Fixture=preload("res://tests/support/grayriver_fixture.gd")
func at(point: Vector2) -> void:
	game.player.position=point;game.player.get_node("Camera2D").reset_smoothing();await frames(6)
func tap(code: Key) -> void:
	await key(code,true);await key(code,false)
func run() -> void:
	root.size=Vector2i(1152,648)
	var fixture:=Fixture.new(self);game=await fixture.boot(true)
	GameRuntime.instance.set_process(true)
	for foe in game.active_enemies:foe.process_mode=Node.PROCESS_MODE_INHERIT
	await at(Vector2(-3500,2350));await tap(KEY_F);await click("记入日志，继续探索")
	await at(Vector2(-3850,2300));await tap(KEY_F);await click("记入日志，继续探索")
	await at(Vector2(-4100,2960));await capture("town-inn-door");await tap(KEY_F);await frames(8)
	check(game.region_id=="river_inn" and not game.player.ui_blocked,"Real F did not enter inn")
	await at(Vector2(0,-80));await capture("inn-common-room")
	var store:=game.session.inventory;store.receive("player","resin_sprayer",1)
	var uid:=store.find_owned("player","resin_sprayer");store.spend_instance("player",uid,"doses",1)
	var title: String=store.definitions.resin_sprayer.display_name
	await at(Vector2(-520,225));await tap(KEY_F);await click("存入物品");await click(title+" ×1");await click("存入整组")
	check(store.locate(uid)=="storage.town.inn.player" and store.item(uid).properties.doses==2,"Real storage UI lost used spray identity")
	await click("取出物品");await click(title+" ×1");await capture("storage-actual-instance")
	await click("取整组到背包")
	check(store.locate(uid)=="player.pack" and store.item(uid).properties.doses==2,"Real withdrawal did not preserve doses")
	await click("存入物品");await click(title+" ×1 · 背包");await click("存入整组");await tap(KEY_ESCAPE)
	await at(Vector2(160,-20));await tap(KEY_F);await click("这里能做什么？");await capture("innkeeper-conversation")
	await click("买卖食物与补给")
	var grain: int=store.count("player","grain");var bread: int=store.count("player","ration")
	await click("谷粮 ×%d · 1币"%grain);await click("出售一件 · 1币");await click("出售一件 · 1币")
	await click("购买实物");await click("烤饼 ×6 · 2币");await click("购买一件 · 2币")
	check(store.count("player","grain")==grain-2 and store.count("player","ration")==bread+1 and store.count("river.innkeeper","coin")==16,"Indoor real trade broke stock/purse conservation")
	await capture("inn-real-provision-trade");await tap(KEY_ESCAPE)
	await at(Vector2(-450,-100));await tap(KEY_F);await capture("inn-hourly-rest")
	var clock:=game.session.inventory.clock_seconds
	bread=store.count("player","ration");var water:=store.count("player","clean_water")
	await tap(KEY_F);await create_timer(3.4).timeout;await frames(4)
	check(game.session.inventory.clock_seconds-clock>=3600.0/WorldTime.instance.time_scale and store.count("player","ration")==bread-1 and store.count("player","clean_water")==water-1,"Bed rest did not advance an actual hour and consume provisions")
	await at(Vector2(450,-155));await tap(KEY_F);await capture("inn-cooking");await tap(KEY_ESCAPE)
	await tap(KEY_M);await capture("inn-local-map")
	var map: GrayriverMap
	for child in root.find_children("*","Control",true,false):
		if child is GrayriverMap:map=child;break
	check(map!=null and map.local_mode,"G did not open current interior plan")
	if map:await point_click(map.get_global_transform()*map.project(Vector2(-450,-100)))
	check(game.progress.waypoint.get("region","")=="river_inn","Local map click created an overworld waypoint")
	await click("河谷全图");check(map!=null and not map.local_mode,"World map toggle refused")
	await click("当前室内");root.size=Vector2i(960,600);await frames(8);await capture("inn-local-map-small");await tap(KEY_ESCAPE)
	await tap(KEY_F5);var waypoint:=game.progress.waypoint.duplicate(true)
	await fixture.close();fixture=Fixture.new(self);game=await fixture.boot(true);GameRuntime.instance.set_process(true)
	check(game.region_id=="river_inn" and game.session.inventory.locate(uid)=="storage.town.inn.player" and game.session.inventory.item(uid).properties.doses==2 and game.progress.waypoint==waypoint,"Real F5/re-entry lost interior, storage or waypoint")
	await at(Vector2(0,350));await tap(KEY_F);await frames(8)
	check(game.region_id=="camp" and game.player.position.distance_to(Vector2(-4100,2960))<2,"Inn exit returned to the wrong exterior door")
	await at(Vector2(-4250,1600));await tap(KEY_F);await frames(8);check(game.region_id=="river_workshop","Workshop door did not enter")
	await at(Vector2(-310,-85));await tap(KEY_F);await click("火石");await click("加工：火石");await capture("workshop-real-crafting");await tap(KEY_ESCAPE)
	check(game.player.skill_manager.combinations.supplies.count("fire_stone")==1,"Interior workbench failed to consume ingredients/create firestone")
	await at(Vector2(0,330));await tap(KEY_F);await frames(8)
	await at(Vector2(-2550,2800));await tap(KEY_F);await frames(8);check(game.region_id=="river_records","Records hall door did not enter")
	await at(Vector2(-190,-60));await tap(KEY_F);await capture("records-readable-directory");await click("记入日志，继续探索")
	check(game.progress.claims.has("town.records.directory") and not game.progress.visited.has("river_archive"),"Reading directory remotely discovered a dungeon")
	await at(Vector2(0,330));await tap(KEY_F);await frames(8)
	check(game.region_id=="camp" and game.player.position.distance_to(Vector2(-2550,2810))<2 and not paused,"Records exit or live world state wrong")
	await fixture.close()
	if failures.is_empty():print("PASS town cell input: real F three doors/returns, chest deposit/withdraw UID/doses, indoor host/services, hourly rest/cook UI, local/world map and small window, actual F5/re-entry, real interior crafting, readable records without remote discovery; controlled positions/stock with normal simulation")
	quit(0 if failures.is_empty() else 1)
