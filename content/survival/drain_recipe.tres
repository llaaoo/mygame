[gd_resource type="Resource" script_class="ExplorationDiscoveryData" format=3]
[ext_resource type="Script" path="res://gameplay/exploration/data/discovery_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = "survival.drain_recipe"
title = "回廊食谱：苦叶炖汤"
pos = Vector2(-320, 96)
intro_text = "这份食谱教会苦叶炖汤。它用烤饼、苦叶和饮用水制作，会替换烤饼的食物收益；到锅边可先比较成本。"
text = "学会炖汤：烤饼1、苦叶1、饮用水1。饱食+35、饮水+20、疲劳-8，240秒生命回复+0.4、法力回复+0.5/秒，替换烤饼的食物收益。谷粮与苦叶可在标记处重新采集，但需要240秒游戏时间再生。\n\n此处水源在修好排污泵后提供清水；冰面不能取水，导电水危险。普通水引洗毒不等于把水源净化，先净水或修泵。"
materials = {"grain": 2, "herb": 1}
