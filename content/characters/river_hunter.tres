[gd_resource type="Resource" script_class="ActorCharacterData" load_steps=8 format=3]
[ext_resource type="Script" path="res://gameplay/characters/actor_character_data.gd" id="data"]
[ext_resource type="Script" path="res://gameplay/abilities/loadout/skill_loadout.gd" id="loadout"]
[ext_resource type="Resource" path="res://gameplay/abilities/data/focus_data.tres" id="focus"]
[ext_resource type="Resource" path="res://content/frontier/equipment/river_spear.tres" id="river_spear"]
[ext_resource type="Resource" path="res://content/frontier/equipment/river_boots.tres" id="river_boots"]
[ext_resource type="Resource" path="res://content/tactics/spacing.tres" id="temperament"]
[sub_resource type="Resource" id="Loadout"]
script = ExtResource("loadout")
slots = Array[String](["focus"])
[resource]
script = ExtResource("data")
temperament = ExtResource("temperament")
id = "river_hunter"
title = "驿路追猎者"
strength = 3
intelligence = 3
agility = 12
endurance = 1
base_move_speed = 100.0
melee_multiplier = 0.6
skills = [ExtResource("focus")]
