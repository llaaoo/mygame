[gd_resource type="Resource" script_class="NpcProfile" format=3]
[ext_resource type="Script" path="res://gameplay/social/npc_profile.gd" id="profile"]
[ext_resource type="Script" path="res://gameplay/social/npc_topic.gd" id="topic"]
[ext_resource type="Script" path="res://gameplay/exploration/data/navigation_hint.gd" id="hint"]
[ext_resource type="Resource" path="res://content/social/aida_character.tres" id="character"]
[ext_resource type="Resource" path="res://content/foundation/trainer_schedule.tres" id="schedule"]

[sub_resource type="Resource" id="hunter_lead"]
script = ExtResource("hint")
target_claim = "river.fire"

[sub_resource type="Resource" id="archive_lead"]
script = ExtResource("hint")
target_claim = "river.dossier"

[sub_resource type="Resource" id="outpost_lead"]
script = ExtResource("hint")
target_claim = "river.outpost"

[sub_resource type="Resource" id="about"]
script = ExtResource("topic")
id = "about"
title = "你如何记录行路人的成果？"
response = "委托板记录河谷的大事，我也托人办些小事。传闻只进你的日志，地图上是否发现过那里，仍以你亲自走到为准。"

[sub_resource type="Resource" id="quests"]
script = ExtResource("topic")
id = "quests"
title = "查看河谷委托"
response = "看看你亲自找到的证据和已经完成的成果，再决定追踪哪条线索。"
kind = 1
category = "服务"
service = "quests"

[sub_resource type="Resource" id="routes"]
script = ExtResource("topic")
id = "routes"
title = "北路和东路各有什么？"
response = "先领离镇口粮旧械包，按O穿上短刀，附近布料包留一份给档案窖检修。北路猎营有行路与火阵知识，阅读不要求施法；借入口和书架应对守卫，付布料1修压印台，取名册再回来。旧试感台只是可选探索，试感不等于觉醒。东路旧驿站可成为前哨，先观察退路。"
navigation_hints = [SubResource("hunter_lead"), SubResource("outpost_lead")]

[sub_resource type="Resource" id="herbs"]
script = ExtResource("topic")
id = "herbs"
title = "委托：留一份药草储备"
response = "给我2份草药，我付6河谷币。留给受伤的行路人；这批储备只收一次。"
kind = 2
category = "人情委托"
requested_items = {"herb": 2}
payment = {"coin": 6}

[sub_resource type="Resource" id="archives"]
script = ExtResource("topic")
id = "archives"
title = "能告诉我更远的档案线索吗？"
response = "档案窖里有一份名册，可能改变仍在执行旧令的老兵的态度。这里只给线索，不算你已经调查了那里。"
navigation_hints = [SubResource("archive_lead")]
category = "信任"
minimum_disposition = 10

[sub_resource type="Resource" id="bridge_deed"]
script = ExtResource("topic")
id = "bridge_deed"
title = "木桥已经修好了"
response = "你修好了中部木桥，往返不必再绕那么远。这是真正改变河谷的成果，我会记下来。"
category = "河谷成果"
required_claims = PackedStringArray("river.bridge_fixed")
recognition = 10

[sub_resource type="Resource" id="analysis"]
script = ExtResource("topic")
id = "analysis"
title = "我能从旧档案里分析出什么？"
response = "观察文书的签发时间和守岗的实际理由，再去核对当事人的说法。线索并不等于新命令，找到名册后亲手出示，才能让仍在守岗的老兵作决定。"
category = "能力见解"
required_attributes = {"intelligence": 12}

[sub_resource type="Resource" id="inn_lead"]
script = ExtResource("hint")
target_region = "river_inn"
[sub_resource type="Resource" id="workshop_lead"]
script = ExtResource("hint")
target_region = "river_workshop"
[sub_resource type="Resource" id="records_lead"]
script = ExtResource("hint")
target_region = "river_records"
[sub_resource type="Resource" id="town_rooms"]
script = ExtResource("topic")
id = "town_rooms"
title = "镇里有哪些能进去的屋子？"
response = "门牌下按F就能进去。灰苇客栈有客床、个人寄存箱和柴灶，作坊可以制造和整备，公署有公开文书。萨芙和训练师白天仍在集市当值；进屋不会补货、跳时或恢复伤势。"
navigation_hints = [SubResource("inn_lead"), SubResource("workshop_lead"), SubResource("records_lead")]

[sub_resource type="Resource" id="mediation"]
script = ExtResource("topic")
id = "mediation"
title = "处理私产纠纷与遗产委托"
response = "核对实际条件、本人日程与库存后办理。"
kind = 1
category = "服务"
service = "mediation"

[resource]
script = ExtResource("profile")
actor_id = "river.aida"
role = "镇中委托、行路线索与河谷见闻"
character = ExtResource("character")
schedule = ExtResource("schedule")
work_position = Vector2(-2840, 2260)
rest_position = Vector2(-3820, 2680)
greeting = "我记下的是行路人亲手做成的事。你想找活干，还是问问这片河谷？"
familiar_greeting = "又见面了。你为河谷做的事我记着，我愿意把更远处的消息也告诉你，但传闻终究得自己去验证。"
topics = [SubResource("mediation"), SubResource("analysis"), SubResource("about"), SubResource("quests"), SubResource("routes"), SubResource("town_rooms"), SubResource("herbs"), SubResource("archives"), SubResource("bridge_deed")]
