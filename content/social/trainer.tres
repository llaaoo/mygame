[gd_resource type="Resource" script_class="NpcProfile" format=3]
[ext_resource type="Script" path="res://gameplay/social/npc_profile.gd" id="profile"]
[ext_resource type="Script" path="res://gameplay/social/npc_topic.gd" id="topic"]
[ext_resource type="Resource" path="res://content/foundation/trainer.tres" id="character"]
[ext_resource type="Resource" path="res://content/training/catalog.tres" id="training"]

[sub_resource type="Resource" id="about"]
script = ExtResource("topic")
id = "about"
title = "战斗应该先练什么？"
response = "先看距离、体力和敌人收招。左键短按轻击、长按后松开重击，右键格挡。破势斩课程8河谷币，可在“学习武技与野外技艺”中购买；留住趁手武器与防具，多余装备才卖给萨芙，不必为法阵路线买课。学会后持刀剑，轻→重完成出招后可接破势斩；轻→轻须末击有效命中，才能接截势斩。窗口出现后Ctrl+左键手动接招，短按或按住松开分别发动轻、重武技，不花MP。K查看连招配置，不占法术或物品快捷槽。不必每次都抢窗口，更别空挥凑招。"

[sub_resource type="Resource" id="training"]
script = ExtResource("topic")
id = "training"
title = "学习武技与野外技艺"
response = "破势斩课程收8河谷币，学会后需手持刀剑才能使用，不花MP；K武技页查看连招配置，不绑定法术或物品快捷槽。先留好趁手武器和防具，多余战利品可卖给萨芙，按实收钱币决定是否学课；法阵行路者不必买这门课。我教知识，不送武器、箭或附魔。其他课程各有条件；剥皮、取牙与摘腺也要先学会，再携刀处理实物遗骸。"
kind = 1
category = "服务"
service = "training"

[sub_resource type="Resource" id="progression"]
script = ExtResource("topic")
id = "progression"
title = "谈谈等级与成长"
response = "成功实践提升熟练度。升级给属性点和通用Perk点，满足基础属性与前置才能学习。"
kind = 1
category = "服务"
service = "progression"

[sub_resource type="Resource" id="preparation"]
script = ExtResource("topic")
id = "preparation"
title = "怎样使用法阵而不挨打？"
response = "先确认自己是否已经觉醒，读书和敬神都不等于获得魔力。尚未觉醒就用武器、真实涂料与药剂；不必为探险接受觉醒代价。已觉醒者也应在敌人看不见或够不着的位置先准备，消耗火石布火阵，再以火花触发火球；默认凝能阵不会凭空变成火阵。武器路线可先靠格挡与短招稳住体力，等敌人收招再压制；不必为了学武技改变法阵路线。打开菜单也挡不住来袭的敌人。"

[sub_resource type="Resource" id="ration"]
script = ExtResource("topic")
id = "ration"
title = "委托：训练后的口粮"
response = "给我1份烤饼，我付3河谷币。烤饼要真正在你身上，别把救急的最后一份也交掉。"
kind = 2
category = "人情委托"
requested_items = {"ration": 1}
payment = {"coin": 3}

[sub_resource type="Resource" id="bridge_deed"]
script = ExtResource("topic")
id = "bridge_deed"
title = "谈谈与断桥守望者的协议"
response = "你亲自解决了断桥的纠纷。能留住补给、也能留住性命，这同样是战斗判断。"
category = "河谷成果"
required_claims = PackedStringArray("river.bridge_settled")
recognition = 10

[sub_resource type="Resource" id="pressure"]
script = ExtResource("topic")
id = "pressure"
title = "能谈谈重击与破势的取舍吗？"
response = "力量不能替你支付体力。重击和破势会提高压制机会，却也延长承诺。用短招逼对手落空，再把有限体力花在确有机会的一击上。"
category = "能力见解"
required_attributes = {"strength": 12}

[sub_resource type="Resource" id="charters"]
script = ExtResource("topic")
id = "charters"
title = "身份与专长誓约"
response = "核对实际条件、本人日程与库存后办理。"
kind = 1
category = "服务"
service = "charters"

[resource]
script = ExtResource("profile")
actor_id = "river.enemy.service.trainer"
threat_response = 1
role = "武器战技与战斗准备"
character = ExtResource("character")
training = ExtResource("training")
greeting = "先把呼吸放稳。想学招式，还是谈谈为什么总在出招后挨打？"
familiar_greeting = "你的行路判断我记着。今天练哪条路线？本领要靠你自己把动作接起来。"
topics = [SubResource("charters"), SubResource("pressure"), SubResource("about"), SubResource("training"), SubResource("progression"), SubResource("preparation"), SubResource("ration"), SubResource("bridge_deed")]
