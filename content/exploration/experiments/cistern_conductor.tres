id = "magic.waterworks_conductor"
title = "水路检修晶闸"
pos = Vector2(288, 96)
routes = Array[ExtResource("route")]([SubResource("route")])
hint = "这里需要实际导电水域保持0.5秒。E操作西侧分流阀接通水路；冰面截断传导，震荡能破冰接回。已启动后永久解锁补给和东北侧独立返营升降机，无需持续供电。也可用自己的水引铺设介质。原有返程不受此机关限制。"
materials = { "crystal": 3, "storm_dust": 1 }
