[sub_resource type="Resource" id="Resource_ivo0c"]
script = ExtResource("1_2tmke")
id = "focus_knowledge"
title = "凝神碑：余烬与霜行"
text = "已掌握凝神（2）。阵外凝神：5秒内移动速度提高8%。火阵＋凝神：余烬战意，10秒内近战攻击力+8并附带火焰命中，保留时火焰法术伤害+20%；Shift施法消耗余烬强化本次效果，随后失去持续收益；霜阵＋凝神：霜行，8秒内移动速度+30%并使普通冰霜施法伤害+20%；Shift施法消耗霜行，换取穿透/范围与更高伤害。两个组合均需10 MP和一次触发。凝神增益互相替换，重复释放刷新，不叠加。离开区域后清理。"
pos = Vector2(-350, 180)
actions = Array[String](["focus"])
spell_rules = Array[String](["fire_sigil_focus", "frost_sigil_focus"])
requires_clear = true

[sub_resource type="Resource" id="Resource_fr7ah"]
script = ExtResource("1_2tmke")
id = "sanctum_supply"
equipment = Array[String](["soul_amulet"])
title = "祈堂储备"
text = "取得一次性储备，恢复60点生命与法力。凝神增益让你在近战切入和远程拉扯之间选择。"
pos = Vector2(-350, -180)
heal = true
requires_clear = true

[sub_resource type="Resource" id="Resource_4radt"]
script = ExtResource("1_2tmke")
id = "sanctum_sap"
title = "封存树液"
text = "取得施法原料。返回营地工作台可加工，M查看库存。此处只搜刮一次，休息与重置遭遇都不会重新发放。"
pos = Vector2(350, 230)
materials = {
"sap": 6
}

[sub_resource type="Resource" id="Resource_2wqfn"]
script = ExtResource("1_2tmke")
id = "echo_knowledge"
title = "回响刻板：印记与转化"
text = "学会回响铭印（用K编组），6 MP和回响墨1换取12秒印记。印记内火花→三重矢，震荡→三次脉冲，凝神→40%减伤护盾，水引→持续恢复。普通震荡保留护盾；按住Shift再接震荡才主动爆破。相容的回响与法阵可共同触发；互斥增益按优先级取一个，护盾爆破优先于回响脉冲。成功转化才消耗状态，跨区清理；M可配置新增材料。"
pos = Vector2(0, -220)
actions = Array[String](["echo_mark"])
spell_rules = Array[String](["echo_spark", "echo_pulse", "echo_focus", "echo_water", "guard_pulse"])
materials = {
"crystal": 4,
"echo_ink": 5,
"sap": 4,
"ward_powder": 2
}
requires_clear = true

