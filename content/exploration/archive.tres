[sub_resource type="Resource" id="Resource_6u4p8"]
script = ExtResource("1_pn3v5")
id = "cartographer_rescued"
title = "被困的测绘员艾妲"
text = "艾妲：谢谢！我沿着你清理的道路返回营地。在档案室北侧的祈堂里，凝神可以借法阵化为增益；水路尽头的机房还能改变熔炉的力量。回来找我交付营地委托吧。"
pos = Vector2(-350, -180)
hide_when_claimed = true
requires_clear = true
kind = "person"

