hint = "晶簇可由雷电直接共鸣；也可先以冰霜或火焰处理外壳，再用震荡冲开。首次探索可用火花→震荡，无需消耗品。解开取得雷晶粉2、晶砂2，并开启东北侧返营检修升降机。未完成的顺序跨区重置，已完成永久保留。"
materials = {
"crystal": 2,
"storm_dust": 2
}



