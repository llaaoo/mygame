[sub_resource type="Resource" id="Resource_cq0b6"]
script = ExtResource("1_rfnbd")
id = "frost_knowledge"
title = "寒霜铭刻记录"
intro_text = "已掌握霜阵（3）。先在安全位置布阵，再用火花发出寒霜弹，减速靠近的敌人。\n\n冻结之后可以保留控制，也可以离开法阵用震荡碎冰，换取伤害并恢复水路。已清场后可在Esc重试本区，击杀没有奖励。"
text = "已掌握霜阵（3）。霜阵内使用同一个火花会产生寒霜弹，命中减速并冻结潮湿表面。不同类型法阵可以叠放，同类重建只更新自己；重叠处同一个动作可触发多个结果，费用相加。\n\n阵外震荡或回响脉冲能打碎已冻结目标，额外50%伤害，代价是失去剩余冻结控制。震荡也能打碎冻结地面、恢复水路，再接雷电沿连通水面传播。\n\n水系的凝霜形态也能作为准备：学会凝神后，Shift凝神借脚下冰面准备霜行，10 MP并消耗所在1格；或在M配置霜盐，1份和额外2 MP替代地面。普通水不会触发霜行。"
pos = Vector2(-350, 180)
actions = Array[String](["frost_sigil"])
spell_rules = Array[String](["terrain_frost_focus", "frost_sigil_spark"])
element_clues = Array[String](["water"])

[sub_resource type="Resource" id="Resource_mex14"]
script = ExtResource("1_rfnbd")
id = "drain_crystals"
title = "回廊结晶苔"
text = "取得施法原料。返回营地工作台可加工，M查看库存。此处只搜刮一次，休息与重置遭遇都不会重新发放。"
pos = Vector2(-300, -200)
materials = {
"crystal": 6
}

[sub_resource type="Resource" id="Resource_6c60e"]
script = ExtResource("1_rfnbd")
id = "venom_knowledge"
title = "毒理记录：雾与孢子"
intro_text = "已掌握毒雾（K编组），并取得毒性萃取。先用毒区限制接近，再比较继续施毒与火花引爆的效果。清洁水能洗毒，自己也会受到污染地面影响。\n\n想复用水引，可在M给它配置毒性萃取；落地会变为毒地，失去洗毒用途。材料会消耗。"
text = "学会毒雾（K编组），6 MP和毒性萃取1制造10秒毒区。水引冲洗毒区并解除中毒；火球可引爆中毒目标，冰霜可用于减速留人。回响印记＋毒雾变为穿透孢子，仍消耗毒性萃取。M给冰霜触发配置毒性萃取，还可同时施加冻结与中毒。\n\n用近距离火花或火焰近战也能引爆中毒，不必总用火球。一次命中新挂上的状态不会在同次命中被当成预先准备；可以先毒性冰霜，再用火花同时融冰、引爆。\n\n毒性萃取同样能改变水引：水域先变毒地，不再用于洗毒。若戴守阵者指环，在火阵内Shift施放这份水引，毒地会继续被引燃；消耗一份材料、一次火阵充能和额外法力，落点仍由你选择。\n\n学会凝神后，Shift凝神借脚下毒地准备毒契，8 MP并消耗所在1格；或给凝神配置毒性萃取，1份和额外3 MP替代地面。毒契解除并免疫中毒，完整消费后会失去抗毒；节律护手能以额外法力保留一半剩余时长。"
pos = Vector2(100, -220)
actions = Array[String](["venom_mist"])
spell_rules = Array[String](["terrain_poison_focus", "echo_venom"])
materials = {
"charcoal": 3,
"sap": 4,
"venom_extract": 5
}
requires_clear = true
element_clues = Array[String](["poison"])

