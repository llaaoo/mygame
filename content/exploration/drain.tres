[sub_resource type="Resource" id="Resource_cq0b6"]
script = ExtResource("1_rfnbd")
id = "frost_knowledge"
title = "寒霜铭刻记录"
text = "已掌握霜阵（3）。霜阵内使用同一个火花会产生寒霜弹，命中减速并冻结潮湿表面。不同类型法阵可以叠放，同类重建只更新自己；重叠处同一个动作可触发多个结果，费用相加。"
pos = Vector2(-350, 180)
actions = Array[String](["frost_sigil"])
spell_rules = Array[String](["frost_sigil_spark"])

[sub_resource type="Resource" id="Resource_mex14"]
script = ExtResource("1_rfnbd")
id = "drain_crystals"
title = "回廊结晶苔"
text = "取得施法原料。返回营地工作台可加工，M查看库存。此处只搜刮一次，休息与重置遭遇都不会重新发放。"
pos = Vector2(-300, -200)
materials = {
"crystal": 6
}

[sub_resource type="Resource" id="Resource_6c60e"]
script = ExtResource("1_rfnbd")
id = "venom_knowledge"
title = "毒理记录：雾与孢子"
text = "学会毒雾（K编组），6 MP和毒性萃取1制造10秒毒区。水引冲洗毒区并解除中毒；火球可引爆中毒目标，冰霜可用于减速留人。回响印记＋毒雾变为穿透孢子，仍消耗毒性萃取。M给冰霜触发配置毒性萃取，还可同时施加冻结与中毒。"
pos = Vector2(100, -220)
actions = Array[String](["venom_mist"])
spell_rules = Array[String](["echo_venom"])
materials = {
"charcoal": 3,
"sap": 4,
"venom_extract": 5
}
requires_clear = true

