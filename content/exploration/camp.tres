[sub_resource type="Resource" id="Resource_frse3"]
script = ExtResource("1_lptr4")
id = "camp_guide"
title = "远征者手记"
text = "火花本身只影响近处。真正的法术来自条件：寻找监狱外院的火阵铭刻记录。死亡返回营地，已学知识和清理进度保留。"
pos = Vector2(-200, -160)

[sub_resource type="Resource" id="Resource_yc7l5"]
script = ExtResource("1_lptr4")
id = "material_handbook"
title = "施法材料手册"
text = "已掌握水引：前方制造水域、灭火并令敌人潮湿（默认4）。已掌握泼洒树脂：消耗树脂制剂铺油，需在K中编组。领取初始原料和成品。按M给基础动作配置可选素材；营地工作台可加工。灰延长火/霜法阵，树脂强化火球，霜盐强化冰霜，雷晶粉维持雷阵或强化雷矢。基础火/霜不强制带料。"
pos = Vector2(-220, 200)
actions = Array[String](["water_call", "oil_flask"])
materials = {
"ash": 2,
"charcoal": 4,
"crystal": 6,
"frost_salt": 2,
"resin": 2,
"sap": 6,
"storm_dust": 3
}

