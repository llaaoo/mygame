[gd_resource type="Resource" script_class="ExplorationDiscoveryData" format=3]
[ext_resource type="Script" path="res://gameplay/exploration/data/discovery_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = "alchemy.schematic"
title = "调和台检修图纸"
pos = Vector2(160, -240)
text = "图纸已记录。回廊排污泵中有泵芯，机房旧调压器中有调压芯。设备可通过属性检修，也能用既有法术处理；解封后必须靠近E取件。可先探索，再回营地接下“重启调和台”。\n\n回廊：力量14站定2秒撬拆；或火花→水引→震荡，或凝霜→震荡。冲净旧毒区会失去毒地阻敌的作用。机房：智力14站定2.5秒校准，或设备所在格蒸汽保持半秒，或树脂制剂1与晶砂2站定1.5秒修补。首次开封会泄出6秒蒸汽。\n\nE查看、Q切换、E开始；观察与作业都不暂停，站定时受伤会中断，只有成功完成才扣材料。取回两件后，在营地东北调和台组装3秒，无额外费用。修复永久开启成品回收，再到委托板领1属性点。"
