[sub_resource type="Resource" id="Resource_r355u"]
script = ExtResource("1_0us06")
id = "fire_knowledge"
title = "火阵铭刻记录"
text = "已掌握火阵。按5铭刻，阵内使用右键或6火花发出火球；阵外仍是近距离火花。火阵仅有两次触发量，注意留出准备窗口。\n\n阵外火花也能点燃油面、融化冻结和引爆中毒；火阵提供远程形态，元素的用途并不依赖站在法阵里。\n\n学会凝神后，Shift凝神可借脚下燃烧准备余烬战意，10 MP并消耗所在1格；也可在M给凝神配置树脂，消耗1份和额外4 MP替代地面。火地仍会伤你，准备不是免火。"
pos = Vector2(-350, 180)
actions = Array[String](["fire_sigil"])
spell_rules = Array[String](["terrain_fire_focus", "fire_sigil_fireball"])
element_clues = Array[String](["fire"])

