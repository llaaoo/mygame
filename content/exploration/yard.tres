[sub_resource type="Resource" id="SoulCache"]
script = ExtResource("6_kxefh")
id = "magic.soul_cache"
title = "缄默骨匣"
pos = Vector2(-230, 250)
routes = Array[ExtResource("7_gc3xg")]([SubResource("SoulRoute")])
hint = "封印回应魂术，而非寻常火焰。阅读外院魂术拾遗，借残魂兑现魂焰矢或魂霜震荡。解开获得回响墨2、守护粉1；离开区域不会重置已领材料。"
materials = {"echo_ink": 2, "ward_powder": 1}

