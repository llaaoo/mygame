[sub_resource type="Resource" id="SoulKnowledge"]
script = ExtResource("1_0us06")
id = "soul_knowledge"
title = "魂术拾遗：残魂与蕴魂"
text = "守卫战死留下60秒残魂。靠近后使用汲魂（K编组）消耗4 MP，获得1层蕴魂，最多3层、持续45秒。普通施法保留；Shift＋火花→穿透魂焰，震荡→魂霜，凝神→先祖护佑，水引→净魂，每次消费1层。触发动作仍须沿支路学习。回响印记与护盾爆破优先；魂术可与适配法阵结果共同发生，总费用相加。材料沿用：树脂铺火、墨加穿透、霜盐扩范围、守护粉延时。残魂和临时Buff跨区清理，不可带回营地囤积。"
pos = Vector2(-360, -210)
actions = Array[String](["soul_harvest"])
spell_rules = Array[String](["soul_spark", "soul_pulse", "soul_focus", "soul_water"])

