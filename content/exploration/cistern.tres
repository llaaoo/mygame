[sub_resource type="Resource" id="Resource_p7lin"]
script = ExtResource("1_dhw8p")
id = "nova_knowledge"
title = "寒霜新星试验记录"
text = "已学会霜阵＋震荡：寒霜新星。12 MP，消耗一次法阵触发，在法阵周围造成冰霜伤害并减速。若尚未学会震荡，回外院的军械档案室补全基础动作。"
pos = Vector2(-350, 180)
spell_rules = Array[String](["frost_sigil_pulse"])
requires_clear = true

[sub_resource type="Resource" id="Resource_olfsw"]
script = ExtResource("1_dhw8p")
id = "storm_knowledge"
equipment = Array[String](["cadence_gloves"])
title = "雷阵与导电实验记录"
intro_text = "已掌握雷阵（K编组），取得节律护手与雷晶粉。先按E切换分流阀，观察水路连到哪里。\n\n在M给水引配置雷晶粉，从水路远端导电；站在干地操作。晶闸需要实际导电保持半秒，干地上直接雷击无效。护手可回营地查看。"
text = "已掌握雷阵。每次铭刻需要9 MP和雷晶粉1；雷阵＋火花＝雷矢（11 MP），＋震荡＝雷环（13 MP），＋凝神＝雷息（10 MP）。先用水引令目标潮湿，可强化雷击并使水面带电。用K把雷阵编入快捷槽；M可将火花配置雷晶粉，雷矢会变成三发散射。\n\n雷晶粉也可以配置给水引，造水时直接使水带电，沿已有相连水面传播。无需新学一招雷水；消耗同一份粉，也承担自伤风险。\n\n学会凝神后，Shift凝神借脚下导电水域准备雷息，10 MP并消耗所在1格；或在M给凝神配置雷晶粉，1份和额外4 MP替代地面。其余水路仍然带电，准备不会免除感电。"
pos = Vector2(-350, -180)
actions = Array[String](["storm_sigil"])
spell_rules = Array[String](["terrain_lightning_focus", "storm_sigil_spark", "storm_sigil_pulse", "storm_sigil_focus"])
materials = {
"crystal": 3,
"storm_dust": 3
}
requires_clear = false
element_clues = Array[String](["lightning"])

