[sub_resource type="Resource" id="Resource_p7lin"]
script = ExtResource("1_dhw8p")
id = "nova_knowledge"
title = "寒霜新星试验记录"
text = "已学会霜阵＋震荡：寒霜新星。12 MP，消耗一次法阵触发，在法阵周围造成冰霜伤害并减速。若尚未学会震荡，回外院的军械档案室补全基础动作。"
pos = Vector2(-350, 180)
spell_rules = Array[String](["frost_sigil_pulse"])
requires_clear = true

[sub_resource type="Resource" id="Resource_olfsw"]
script = ExtResource("1_dhw8p")
id = "storm_knowledge"
title = "雷阵与导电实验记录"
text = "已掌握雷阵。每次铭刻需要9 MP和雷晶粉1；雷阵＋火花＝雷矢（11 MP），＋震荡＝雷环（13 MP），＋凝神＝雷息（10 MP）。先用水引令目标潮湿，可强化雷击并使水面带电。用K把雷阵编入快捷槽；M可将火花配置雷晶粉，雷矢会变成三发散射。"
pos = Vector2(-350, -180)
actions = Array[String](["storm_sigil"])
spell_rules = Array[String](["storm_sigil_spark", "storm_sigil_pulse", "storm_sigil_focus"])
materials = {
"crystal": 3,
"storm_dust": 3
}
requires_clear = true

