[ext_resource type="Resource" path="res://content/spell_operations/payloads/legacy_arcane_dash.tres" id="arcane_dash"]
[ext_resource type="Resource" path="res://content/spell_operations/payloads/legacy_shadow_step.tres" id="shadow_step"]
[ext_resource type="Resource" path="res://content/spell_operations/payloads/legacy_phase_blink.tres" id="phase_blink"]
[resource]
