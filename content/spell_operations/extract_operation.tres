[ext_resource type="Resource" path="res://content/spell_operations/extract.tres" id="action"]
[ext_resource type="Resource" path="res://content/spell_operations/payloads/soul_source.tres" id="soul_source"]
[ext_resource type="Resource" path="res://content/spell_operations/payloads/extract_fire.tres" id="extract_fire"]
[ext_resource type="Resource" path="res://content/spell_operations/payloads/extract_frost.tres" id="extract_frost"]
[ext_resource type="Resource" path="res://content/spell_operations/payloads/extract_storm.tres" id="extract_storm"]
[ext_resource type="Resource" path="res://content/spell_operations/payloads/extract_arcane.tres" id="extract_arcane"]
