[sub_resource type="Resource" id="definition"]
script = ExtResource("region")
id = "river_records"
title = "河谷公署"
description = "可进入的镇中地点；F与实物交互，M查看室内地图。"
authored_size = Vector2(1152, 832)
presentation_environment = ExtResource("environment")
[sub_resource type="Resource" id="nav0_0"]
script = ExtResource("nav0")
target_region = "river_inn"
[sub_resource type="Resource" id="nav0_1"]
script = ExtResource("nav0")
target_region = "river_workshop"
[sub_resource type="Resource" id="feature1"]
script = ExtResource("script1")
id = "town.records.directory"
title = "河谷门址与行路图"
text = "河谷镇仍沿集市和公共篝火生活。西北是萨芙的整修作坊，西南是灰苇客栈；镇民白天在原来的摊位和委托板旁当值。进入建筑不会替你恢复生命、补货或跳过时间，离开后仍回到同一扇门。"
requires_clear = false
navigation_hints = [SubResource("nav0_0"), SubResource("nav0_1")]
[sub_resource type="Resource" id="nav1_0"]
script = ExtResource("nav1")
target_region = "river_archive"
[sub_resource type="Resource" id="feature2"]
script = ExtResource("script2")
id = "town.records.river"
title = "巡河档案索引"
text = "这里是公开索引，不是旧档案原件。北路猎营的笔记提及林下档案窖，驿路留下运料单，真正的名册仍需亲自带回并出示给守岗者。读过索引不会替你发现遗迹、取得名册或完成委托。\n\n首次出征可用武器和实物，布料1手工修复压印台、取名册返镇，不要求施法。名册背页提及档案窖西北旧试感台；须先修好压印台并读名册，试感不自动觉醒，也不扣永久属性，之后再自愿决定是否接受明确的永久代价。"
requires_clear = false
navigation_hints = [SubResource("nav1_0")]
[sub_resource type="Resource" id="feature3"]
script = ExtResource("script3")
