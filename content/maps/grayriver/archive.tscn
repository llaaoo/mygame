[sub_resource type="Resource" id="ArchiveIndexPress"]
script = ExtResource("11_xj8ao")
id = "archive.index_press"
title = "受潮档案压印台"
routes = Array[ExtResource("24_index_route")]([SubResource("ArchiveIndexWaterRoute")])
hint = "旧纸屑与蜡封卡住了压印轴。普通旅人可消耗布料1，站定3秒擦拭撬修，不需要魔力；已觉醒者也可先用水引润开，再用震荡松脱。附近守卫仍会打断作业，先借书架分开应对。恢复后，东侧搬运竖井可返回林地；原入口始终开放。"
work_methods = Array[ExtResource("25_index_work")]([SubResource("ArchiveIndexHandwork")])
completion_text = "压印轴重新转动，东侧搬运竖井已可返回林地。既有名册与物资仍在原处，压印台不额外生成奖励；可以带成果回镇报告并整备下一程。"

