[sub_resource type="Resource" id="Resource_3gdhe"]
script = ExtResource("4_wq16e")
id = "demo.dispatch"
title = "巡河调度令"
text = "失联队长把北岸烽堡的风井关闭了。先在上层修好风门，再下风井找信号台。返回镇中可分段交付记录，不必带满背包继续深入。遗钟墓的回执提到下游水闸；三份记录共同说明河谷污染的源头。"
intro_text = "失联队长把北岸烽堡的风井关闭了。先在上层修好风门，再下风井找信号台。返回镇中可分段交付记录，不必带满背包继续深入。遗钟墓的回执提到下游水闸；三份记录共同说明河谷污染的源头。"
navigation_hints = Array[ExtResource("17_ku1q8")]([SubResource("Resource_1fh55")])
