[sub_resource type="Resource" id="Resource_3k8nr"]
script = ExtResource("10_0poi7")
id = "river_archive"
title = "林下档案窖"
description = "沿旧档案寻找水工图纸、回响与食品记录；出口始终开放。"
authored_size = Vector2(2000, 1400)

[sub_resource type="Resource" id="Resource_2xfy3"]
script = ExtResource("4_wq16e")
id = "river.pulse"
title = "搬运工的震荡记录"
text = "震荡（1）可以破冰。先观察目标已有状态，普通近战可以保留冻结控制。"
intro_text = "震荡（1）可以破冰。先观察目标已有状态，普通近战可以保留冻结控制。"
actions = Array[String](["pulse"])
spell_rules = Array[String](["fire_sigil_pulse"])
equipment = Array[String](["keeper_ring"])
metadata/crafting_recipes = []

[sub_resource type="Resource" id="Resource_axxya"]
script = ExtResource("4_wq16e")
id = "alchemy.schematic"
title = "水工与调和台图纸"
text = "读懂泵与调压器的检修。外部工区取泵芯、矿道取调压器，再回镇组装；法术、属性和材料途径都可实际尝试。"
intro_text = "读懂泵与调压器的检修。外部工区取泵芯、矿道取调压器，再回镇组装；法术、属性和材料途径都可实际尝试。"
metadata/crafting_recipes = []

[sub_resource type="Resource" id="Resource_heojv"]
script = ExtResource("4_wq16e")
id = "river.echo"
title = "封存回响刻板"
text = "学会回响铭印，在后续基本动作上亲手触发不同结果。回响墨制造也记在这里。"
intro_text = "学会回响铭印，在后续基本动作上亲手触发不同结果。回响墨制造也记在这里。"
actions = Array[String](["echo_mark"])
spell_rules = Array[String](["echo_spark", "echo_pulse", "echo_focus", "echo_water", "guard_pulse"])
materials = {
"crystal": 4,
"echo_ink": 5,
"sap": 4,
"ward_powder": 2
}
metadata/crafting_recipes = ["echo_ink"]

[sub_resource type="Resource" id="Resource_hrjs5"]
script = ExtResource("4_wq16e")
id = "survival.archive_recipe"
title = "伙房旧谱：醒神茶"
text = "苦叶1、饮用水1在锅边煮茶，可处理疲劳和当前中毒。野外火源失效不会继续免费烹饪。"
intro_text = "苦叶1、饮用水1在锅边煮茶，可处理疲劳和当前中毒。野外火源失效不会继续免费烹饪。"
materials = {
"herb": 2
}
metadata/crafting_recipes = []

[sub_resource type="Resource" id="Resource_d6663"]
script = ExtResource("4_wq16e")
id = "river.dossier"
title = "监狱封锁名册"
text = "水工守卫仍听命于旧监狱的火焰领主。查明工区污染后，可沿北岸或东侧驿道深入。"
intro_text = "水工守卫仍听命于旧监狱的火焰领主。查明工区污染后，可沿北岸或东侧驿道深入。"
