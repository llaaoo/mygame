[ext_resource type="PackedScene" path="res://gameplay/maps/furniture.tscn" id="furniture"]
[ext_resource type="PackedScene" path="res://gameplay/maps/feature.tscn" id="feature"]
[ext_resource type="Resource" path="res://content/presentation/interior.tres" id="environment"]
