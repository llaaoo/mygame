[ext_resource type="PackedScene" path="res://gameplay/maps/arrival.tscn" id="arrival_marker"]

[ext_resource type="Script" path="res://gameplay/maps/world_storage_data.gd" id="property"]
[sub_resource type="Resource" id="private_stock"]
script = ExtResource("property")
id = "storage.town.merchant.sealed"
title = "萨芙封存货箱：他人私产"
access_actor_id = "river.merchant"
allow_theft = true
allow_deposit = false
capacity = 4
initial_items = {"metal_scrap":2,"cloth":2}
[sub_resource type="Resource" id="definition"]
script = ExtResource("region")
id = "camp"
title = "河谷镇门址"
description = "可进入的镇中地点；F与实物交互，M查看室内地图。"
authored_size = Vector2(9600, 7200)
presentation_environment = ExtResource("environment")
[sub_resource type="Resource" id="feature1"]
script = ExtResource("script1")
title = "进入萨芙整修作坊"
target = "river_workshop"
id = "town.workshop.enter"
target_anchor = "entry"
return_exit = "town.workshop.leave"
[sub_resource type="Resource" id="feature2"]
script = ExtResource("script2")
title = "进入灰苇客栈"
target = "river_inn"
id = "town.inn.enter"
target_anchor = "entry"
return_exit = "town.inn.leave"
[sub_resource type="Resource" id="feature3"]
script = ExtResource("script3")
title = "进入河谷公署"
target = "river_records"
id = "town.records.enter"
target_anchor = "entry"
return_exit = "town.records.leave"

[sub_resource type="Resource" id="river_inn_hint"]
script = ExtResource("hint")
target_region = "river_inn"
[sub_resource type="Resource" id="river_workshop_hint"]
script = ExtResource("hint")
target_region = "river_workshop"
[sub_resource type="Resource" id="river_records_hint"]
script = ExtResource("hint")
target_region = "river_records"
[sub_resource type="Resource" id="town_sign"]
script = ExtResource("sign")
id = "town.sign.rooms"
title = "河谷镇门牌"
text = "门牌下按F进入房屋，出来仍回同一扇门。灰苇客栈提供客床、寄存箱、柴灶和实物补给；整修作坊可制造、整备；公署可阅读公开文书。店主、训练师和艾妲白天仍在集市当值。进屋不补货、不自动休息。"
requires_clear = false
navigation_hints = [SubResource("river_inn_hint"), SubResource("river_workshop_hint"), SubResource("river_records_hint")]

[sub_resource type="Resource" id="archive_door"]
script = ExtResource("script1")
id = "archive.enter"
title = "进入林下档案窖"
target = "river_archive"
target_anchor = "entry"
return_exit = "archive.leave"

