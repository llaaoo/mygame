[ext_resource type="Script" path="res://gameplay/items/item_use_definition.gd" id="use"]
[ext_resource type="Script" path="res://gameplay/abilities/operations/spell_payload_data.gd" id="payload"]
[ext_resource type="Resource" path="res://content/status/guard_tonic.tres" id="buff"]
[sub_resource type="Resource" id="Payload"]
script = ExtResource("payload")
id = "guard_tonic"
title = "石肤药剂"
statuses = [ExtResource("buff")]
[sub_resource type="Resource" id="Use"]
script = ExtResource("use")
