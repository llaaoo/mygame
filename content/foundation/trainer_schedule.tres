[gd_resource type="Resource" script_class="NPCSchedule" load_steps=4 format=3]
[ext_resource type="Script" path="res://world/npcs/npc_schedule.gd" id="schedule"]
[ext_resource type="Script" path="res://world/npcs/schedule_entry.gd" id="entry"]
[sub_resource type="Resource" id="work"]
script = ExtResource("entry")
start_hour = 6
end_hour = 22
target_marker = "work"
[sub_resource type="Resource" id="rest"]
script = ExtResource("entry")
start_hour = 22
end_hour = 6
target_marker = "rest"
[resource]
script = ExtResource("schedule")
entries = [SubResource("work"),SubResource("rest")]
