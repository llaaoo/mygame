[resource]
script = ExtResource("tree")
tree_id = "crafting"
display_name = "制造与整修"
description = "成功制造、烹饪及现场作业提高熟练度；失败与取消不奖励。"
school = 7
accent_color = Color(0.72,0.61,0.35,1)
perks = [SubResource("tool_familiarity"), SubResource("arrow_fletcher"), SubResource("salvage_eye"), SubResource("careful_smith"), SubResource("workshop_rhythm")]
