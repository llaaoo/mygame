[gd_resource type="Resource" script_class="SkillTreeData" format=3]
[ext_resource type="Script" path="res://gameplay/abilities/data/skill_tree_data.gd" id="tree"]
[ext_resource type="Script" path="res://gameplay/abilities/data/skill_perk_data.gd" id="perk"]

[sub_resource type="Resource" id="field_lore"]
script = ExtResource("perk")
perk_id = "field_lore"
school = 8
display_name = "野外素养"
description = "饥饿、口渴与疲劳积累降低15%。"
required_level = 1
required_character_level = 2
required_attributes = {}
prerequisite_ids = Array[String]([])
modifier_bonuses = {"survival.needs": -0.15}
column = 1
row = 0

[sub_resource type="Resource" id="pack_habit"]
script = ExtResource("perk")
perk_id = "pack_habit"
school = 8
