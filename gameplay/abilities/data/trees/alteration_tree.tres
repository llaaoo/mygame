[resource]
script = ExtResource("1_tree")
tree_id = "alteration"
display_name = "铭阵与调谐"
description = "铭阵、调谐、塑形、汲取与维持的实践取最高熟练度；学习改进技艺，不授予觉醒、公式或永久物资。"
school = 3
accent_color = Color(0.38, 0.68, 0.95, 1)
skill_ids = ["inscribe", "focus", "shape", "soul_harvest", "sustain"]
perks = [SubResource("Perk_GuardedSkin"), SubResource("Perk_Shatter"), SubResource("Perk_StoneStride"), SubResource("Perk_FrozenEdge"), SubResource("sigil_foundations"), SubResource("sigil_economy"), SubResource("attunement_lore"), SubResource("sigil_reservoir"), SubResource("boon_economy"), SubResource("construct_care"), SubResource("echo_binding")]

